
# Server
PORT=3000
FRONTEND_URL=http://localhost:5173

# MongoDB
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>/<database-name>"

# Auth / JWT
JWT_SECRET="your_jwt_secret_key_here"

# Master admin (optional; not stored in DB as a password)
MASTER_ADMIN_EMAIL="admin@example.com"
# Use either a bcrypt hash or a plain text password (hash recommended)
# MASTER_ADMIN_PASSWORD_HASH="$2a$10$replace_with_bcrypt_hash"
MASTER_ADMIN_PASSWORD="hurace123"

# Email / SendGrid
SENDGRID_API_KEY="SG.xxxxxxxx"
SENDGRID_FROM_EMAIL="no-reply@example.com"
EMAIL_FROM_NAME="Haridwar University ERP"

# Redis (optional)
REDIS_URL=redis://default:<password>@<host>:<port>

# Cloudinary (profile image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional unsigned upload preset fallback
CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Gemini AI (exam paper generation + subjective answer evaluation)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# Python runtime for face verification script.
#
# Docker: PYTHON_BIN is set automatically to /opt/face-verify-venv/bin/python3
#   via docker-compose `environment:` — no change needed here for Docker deployments.
#
# Local development (Linux/macOS):
#   Install deps once:  pip install opencv-python-headless numpy
#   Then use:           PYTHON_BIN=python3
#
# Local development (Windows):
#   Create a venv, activate it, run: pip install opencv-python-headless numpy
#   Then point to the venv:  PYTHON_BIN=C:/path/to/.venv/Scripts/python.exe
#
PYTHON_BIN=python3

# Face verification strict mode:
# - false (default): if OpenCV is unavailable, Python lenient fallback verifies the frame
#                    so the exam flow keeps working (useful for local dev without a camera setup)
# - true:  requires real OpenCV-based face detection; returns an error if cv2 is missing
FACE_VERIFY_STRICT=false
