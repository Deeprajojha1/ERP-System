
# Server
PORT=3000
FRONTEND_URL=http://localhost:5173

# MongoDB
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>/<database-name>"

# Auth / JWT
JWT_SECRET="your_jwt_secret_key_here"

# Email / SendGrid
SENDGRID_API_KEY="SG.xxxxxxxx"
SENDGRID_FROM_EMAIL="no-reply@example.com"
EMAIL_FROM_NAME="Haridwar University ERP"

# Redis (optional)
REDIS_URL=redis://default:<password>@<host>:<port>

# Cloudinary (profile image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Gemini AI (exam paper generation + subjective answer evaluation)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# External Job APIs (for job aggregation)
# Adzuna API - https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# RapidAPI Key for Indeed - https://rapidapi.com/
RAPIDAPI_KEY_INDEED=your_indeed_rapidapi_key
